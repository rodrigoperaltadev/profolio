---
// Admin Entry Listing — see the spec's "Admin Entry Listing" requirement.
// Uses getCollection() + the existing toContentEntry mapper; the render
// loop below is collection-agnostic (a single `groups.map()`), the only
// place collection names are enumerated is this one data-fetch list, the
// same precedent `to-content-entry.ts`'s own `mappers` table already sets.
export const prerender = false; // dynamic per request — see astro.config.mjs

import { getCollection } from "astro:content";
import { toContentEntry } from "../../content/_mappers/to-content-entry";
import { getProfile } from "../../content/profile";
import { isPublishingConfigured } from "../../config/publishing-config";
import CollectionSection from "./_lib/collection-section.astro";
import type { ContentEntry } from "../../content/entry";
import type { Collection } from "../../publishing/content-writer";

interface CollectionGroup {
  collection: Collection;
  entries: ContentEntry[];
}

// `profile` is deliberately NOT a third `CollectionGroup` entry here — it's
// exempt from the shared `ContentEntry`/`CollectionSection` contract (see
// design.md's "`admin/index.astro` profile touch point" decision), so it
// gets its own summary block below instead, calling `getProfile()` directly.
const groups: CollectionGroup[] = [
  { collection: "posts", entries: (await getCollection("posts")).map(toContentEntry) },
  {
    collection: "projects",
    entries: (await getCollection("projects")).map(toContentEntry),
  },
];

const profile = await getProfile();

const params = Astro.url.searchParams;
const hasProfileWrite =
  params.has("profile-created") || params.has("profile-updated") || params.has("profile-reset");
const showCommitReminder =
  !isPublishingConfigured() &&
  (params.has("created") ||
    params.has("updated") ||
    params.has("deleted") ||
    hasProfileWrite);
// Build/Deploy Detection Lag Disclosure (admin-authoring spec) — in GitHub
// mode, a just-saved/reset profile won't clear the first-run redirect until
// the next build/deploy, since `getCollection()`/`getEntry()` only reflect
// the last deploy. Local-fallback mode reads its own disk writes
// immediately, so it gets the existing commit reminder above instead, never
// this notice.
const showDeployLagNotice = isPublishingConfigured() && hasProfileWrite;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Admin</title>
  </head>
  <body>
    <h1>Admin</h1>

    {
      showCommitReminder && (
        <p role="status">Saved to disk only — remember to commit this change.</p>
      )
    }
    {
      params.has("created") && (
        <p role="status">Created "{params.get("created")}".</p>
      )
    }
    {
      params.has("updated") && (
        <p role="status">Updated "{params.get("updated")}".</p>
      )
    }
    {
      params.has("deleted") && (
        <p role="status">Marked "{params.get("deleted")}" as deleted.</p>
      )
    }
    {
      showDeployLagNotice && (
        <p role="status">
          Profile saved, but this won't be reflected here until the next build/deploy.
        </p>
      )
    }
    {params.has("profile-created") && <p role="status">Profile created.</p>}
    {params.has("profile-updated") && <p role="status">Profile updated.</p>}
    {params.has("profile-reset") && <p role="status">Profile reset.</p>}

    <section>
      <h2>Profile</h2>
      {
        profile ? (
          <p>
            {profile.name} — <a href="/admin/profile/edit">Edit profile</a>
          </p>
        ) : (
          <p>
            No profile yet — <a href="/admin/profile/setup">Set up your profile</a>
          </p>
        )
      }
    </section>

    {
      groups.map((group: CollectionGroup) => (
        <CollectionSection collection={group.collection} entries={group.entries} />
      ))
    }
  </body>
</html>

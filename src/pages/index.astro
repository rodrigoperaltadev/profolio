---
// Real public home page — see openspec/changes/public-homepage/design.md's
// Data Flow and File Changes. Renders the profile hero (via getProfile(),
// reusing TerminalWindow) plus a merged, filtered, sorted recent-entries
// teaser when a profile exists; otherwise the "no profile yet" placeholder
// (also reusing TerminalWindow/BrutalistButton for visual consistency).
// Supersedes theme-system's "Minimal Scope Boundary" — see
// openspec/changes/public-homepage/specs/public-pages/spec.md.
export const prerender = true;

import { getCollection } from "astro:content";
import Layout from "../presentation/Layout.astro";
import TerminalWindow from "../presentation/brutalist/TerminalWindow.astro";
import BrutalistButton from "../presentation/brutalist/BrutalistButton.astro";
import { getProfile } from "../content/profile";
import { hasProfile } from "../content/profile-presence";
import { isPubliclyVisible } from "../content/visibility";
import { toContentEntry } from "../content/_mappers/to-content-entry";
import { toSlug } from "../content/slug";
import { byDateDesc, takeRecent } from "../content/sort";
import type { ContentEntry } from "../content/entry";

// Local, unexported teaser shape — see design.md's Interfaces/Contracts:
// merges posts + projects while keeping each entry's own detail-route href,
// without touching the shared ContentEntry contract.
type TeaserItem = ContentEntry & { href: string };

const profile = await getProfile();

const posts = await getCollection("posts");
const projects = await getCollection("projects");

const recentEntries: TeaserItem[] = takeRecent(
  [
    ...posts.filter(isPubliclyVisible).map((entry) => ({
      ...toContentEntry(entry),
      href: `/posts/${toSlug(entry.id)}`,
    })),
    ...projects.filter(isPubliclyVisible).map((entry) => ({
      ...toContentEntry(entry),
      href: `/projects/${toSlug(entry.id)}`,
    })),
  ].sort(byDateDesc),
  3,
);
---

<Layout title="Profolio">
  <main class="min-h-screen p-4">
    {
      hasProfile(profile) ? (
        <>
          <TerminalWindow>
            <h1 class="text-text-primary font-mono text-2xl font-bold">{profile.name}</h1>
            <p class="text-text-secondary font-mono">{profile.role}</p>
            <p class="text-text-secondary font-mono mt-4">{profile.bio}</p>
            {profile.links.length > 0 && (
              <ul class="mt-4 flex flex-wrap gap-4 font-mono text-sm">
                {profile.links.map((link) => (
                  <li>
                    <a href={link.url} class="text-accent underline">
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
            <BrutalistButton variant="secondary" data-theme-toggle class="mt-6">
              Toggle theme
            </BrutalistButton>
          </TerminalWindow>
          <section class="max-w-5xl w-full mx-auto mt-8">
            <h2 class="text-text-primary font-mono text-lg mb-4">Recent</h2>
            {recentEntries.length > 0 ? (
              <ul class="space-y-2 font-mono">
                {recentEntries.map((entry) => (
                  <li>
                    <a href={entry.href} class="text-accent underline">
                      {entry.title}
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="text-text-secondary font-mono">Nothing published yet.</p>
            )}
            <div class="mt-4 flex gap-4 font-mono text-sm">
              <a href="/posts" class="text-accent underline">
                View all posts
              </a>
              <a href="/projects" class="text-accent underline">
                View all projects
              </a>
            </div>
          </section>
        </>
      ) : (
        <TerminalWindow>
          <p class="text-text-primary font-mono">
            No profile yet. Visit{" "}
            <a href="/admin" class="text-accent underline">
              /admin
            </a>{" "}
            to complete setup.
          </p>
          <BrutalistButton variant="secondary" data-theme-toggle class="mt-6">
            Toggle theme
          </BrutalistButton>
        </TerminalWindow>
      )
    }
  </main>
</Layout>

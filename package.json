{
  "name": "profolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Git-as-CMS content/blog engine (open source, reusable/themeable).",
  "license": "MIT",
  "scripts": {
    "setup": "node scripts/setup-wizard.mjs",
    "dev": "node --env-file=.env node_modules/astro/bin/astro.mjs dev",
    "start": "node --env-file=.env dist/server/entry.mjs",
    "pretypecheck": "astro sync",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "verify:content": "node scripts/verify-content-collections.mjs",
    "verify:frontmatter": "node scripts/verify-frontmatter-round-trip.mjs",
    "verify:admin-server": "node scripts/verify-admin-server.mjs",
    "verify:theme": "node scripts/verify-theme-build.mjs",
    "verify:env-file": "node scripts/verify-env-file-loading.mjs",
    "build": "astro build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "1.3.1",
    "eslint-plugin-boundaries": "^7.1.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@astrojs/node": "^11.0.3",
    "astro": "^7.1.4",
    "zod": "^4.4.3"
  }
}
